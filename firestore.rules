rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper checks
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128; 
    }

    function isValidImage(data) {
      return data.get('url', '') is string && data.get('url', '').size() > 0 &&
             data.get('title', '') is string && data.get('title', '').size() > 0 &&
             data.get('category', '') is string &&
             data.timestamp != null;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // App Settings (global config, developer profile)
    match /app_settings/{docId} {
      allow read, write: if true;
    }

    // User Interests (Recommendation engine data)
    match /user_interests/{userId} {
      allow read, write: if true;
    }

    // Categories
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Images Collection
    match /images/{imageId} {
      allow read, write: if true;
    }

    // Comments
    match /comments/{commentId} {
      allow read, write: if true;
    }

    // User Collections
    match /user_collections/{collectionId} {
      allow read, write: if true;
    }

    // Reports
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // Upgrade Requests
    match /upgrade_requests/{requestId} {
      allow read, write: if true;
    }

    // Likes (relational track)
    match /likes/{likeId} {
      allow read, write: if true;
    }

    // Follows
    match /follows/{id} {
      allow read, write: if true;
    }

    // Payments
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Connection Test
    match /_connection_test_/{docId} {
      allow read, write: if true;
    }
  }
}

